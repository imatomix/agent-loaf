{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Loaf",
  "identifier": "io.github.imatomix.agentloaf",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "list",
        "url": "index.html",
        "width": 300,
        "height": 200,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "externalBin": ["binaries/agent-loaf-hook"],
    "resources": {
      "../../.claude-plugin/marketplace.json": "marketplace/.claude-plugin/marketplace.json",
      "../../plugin/.claude-plugin/plugin.json": "marketplace/plugin/.claude-plugin/plugin.json",
      "../../plugin/hooks/hooks.json": "marketplace/plugin/hooks/hooks.json"
    },
    "createUpdaterArtifacts": true,
    "macOS": { "signingIdentity": "-", "minimumSystemVersion": "14.0" }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUwMUIwMkU0NDk2MjZFQzEKUldUQmJtSko1QUliNEFVYVVob05KWis1SUlBNGhjRWVjcGdSSGtkUGFvc0Q2bm9KWFFDMWtDa3gK",
      "endpoints": ["https://github.com/imatomix/agent-loaf/releases/latest/download/latest.json"]
    }
  }
}
